# ==============================================================================
# ScholarPulse — Environment Configuration Template (.env.example)
#
# IMPORTANT: This file contains ONLY placeholder values and documentation.
# Copy this file to .env and set your local environment values.
# NEVER commit the actual .env file or real secrets to source control.
# ==============================================================================

# Application Runtime Settings
APP_ENV=development
APP_NAME=ScholarPulse
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# PostgreSQL Relational Database (Primary Source of Truth)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scholarpulse

# Test Database Connection (Isolated SQLite database used for rapid tests if Postgres is not running)
TEST_DATABASE_URL=sqlite:///./test.db

# CORS Allowed Origins (Comma-separated list or JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Security & Authentication (Required only when authentication/account features are enabled)
# Generate a secure 32+ character key for production: openssl rand -hex 32
SECRET_KEY=placeholder-secret-key-for-development-only-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Paths for Datasets & Artifacts
DATASET_PATH=./datasets/raw/sample_papers.json
ARTIFACTS_PATH=./artifacts

# Optional External Ingestion Adapters (Not required for local operation or tests)
# Leave blank to use local offline sample dataset
OPENALEX_API_KEY=
CROSSREF_MAILTO=
